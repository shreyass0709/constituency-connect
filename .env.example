# Copy to .env and fill in. Never commit .env.
# Validated at boot by src/lib/env.ts (added in the env step).

# ── Database (Neon Postgres) ──
# Pooled connection string for the app runtime + Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Better Auth ──
BETTER_AUTH_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
BETTER_AUTH_URL="http://localhost:3000"
# SMS_PROVIDER=msg91   # dev logs OTP to console; set for prod once DLT is approved

# More vars (Google OAuth, Cloudinary, Gemini, Upstash, Resend, FCM…)
# get added as each feature lands. See docs/02-architecture.md §7.
