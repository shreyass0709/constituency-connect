# Copy to .env and fill in. Never commit .env.
# Validated at boot by src/lib/env.ts (added in the env step).

# ── Database (Neon Postgres) ──
# Pooled connection string for the app runtime + Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Better Auth ──
BETTER_AUTH_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
BETTER_AUTH_URL="http://localhost:3000"
# SMS_PROVIDER=msg91   # dev logs OTP to console; set for prod once DLT is approved

# ── Cloudinary (optional) ──
# Without these, photo/video/voice attachments are simply switched off — the complaint
# flow itself never depends on them.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ── Cron (optional in dev, required in prod) ──
# Guards /api/v1/cron/*. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# CRON_SECRET="generate: node -e \"console.log(require('crypto').randomBytes(24).toString('base64url'))\""

# ── Email (optional — Resend) ──
# Without these the app still notifies in-app and by push; email is simply skipped.
# RESEND_API_KEY=""
# EMAIL_FROM="Constituency Connect <office@your-domain.in>"
# APP_URL="https://your-deployment.vercel.app"   # absolute links in emails/push

# ── Web push (optional — Firebase Cloud Messaging) ──
# Server half: three fields lifted out of the service-account JSON.
# FCM_PROJECT_ID=""
# FCM_CLIENT_EMAIL=""
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
# Client half: the web app config + the Web Push certificate key pair.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── AI (optional — Gemini Flash) ──
# With no key every AI feature falls back: complaints land in the Unclassified triage
# queue, voice notes stay audio, and the public chat widget does not render.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"   # override when a newer Flash ships
# AI_ENABLED="false"                # kill switch; anything else (or unset) means on

# More vars (Google OAuth, Upstash…) get added as each feature lands.
# See docs/02-architecture.md §7.
